{
    "$schema": "https://json.schemastore.org/claude-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run test *)",
      "Bash(npm run build)",
      "Bash(npm run typecheck)",
      "Bash(npx prisma validate)",
      "Bash(npx prisma generate)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
        "Bash(git push *)",
        "Bash(git reset *)",
        "Bash(git clean *)",
        "Bash(rm -rf *)",
        "Bash(npm publish *)",
        "Bash(docker *)",
        "Bash(aws *)",
        "Bash(az *)",
        "Read(.env*)",
        "Read(*.pem)",
        "Read(*.key)"
    ]
  }

}