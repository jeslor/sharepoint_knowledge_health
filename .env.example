# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sharepoint_knowledge_health?schema=public"

# Redis / BullMQ
REDIS_URL="redis://localhost:6379"

# apps/api
API_PORT=3001

# apps/web
NEXT_PUBLIC_API_BASE_URL="http://localhost:3001"

# apps/worker
WORKER_CONCURRENCY=5

# apps/api — Phase 4 authentication (ADR-0011/ADR-0012)
ENTRA_CLIENT_ID="00000000-0000-0000-0000-000000000000"

# packages/graph-client — Phase 5 (ADR-0013)
ENTRA_CLIENT_SECRET="replace-with-a-real-secret-from-key-vault"

# apps/web — Phase 6 frontend MSAL browser auth (ADR-0011 client-side completion)
NEXT_PUBLIC_ENTRA_CLIENT_ID="00000000-0000-0000-0000-000000000000"
NEXT_PUBLIC_API_BASE_URL="http://localhost:3001"

# Phase 9 (production hardening): comma-separated list of allowed frontend
# origins for CORS. Defaults to http://localhost:3000 (apps/web's default dev
# port) when unset — only relevant to set explicitly in staging/production.
# WEB_APP_ORIGIN=https://app.example.com

# apps/api — Phase 6 (trial "Request an upgrade" workflow). Optional: the
# API boots fine without these; EmailService simply fails closed (a clear
# 503 to the caller) if the upgrade-request endpoint is actually invoked
# while unconfigured. Provider is Resend (https://resend.com) — a plain
# REST call, no SDK dependency. EMAIL_FROM must be an address on a domain
# verified with Resend.
# EMAIL_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# EMAIL_FROM="SharePoint Knowledge Health <upgrades@yourdomain.com>"
