{
  "name": "sharepoint-knowledge-health",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.18.0 <21",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @sph/database run generate",
    "db:migrate": "pnpm --filter @sph/database run migrate:dev",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "eslint": "^9.15.0",
    "prettier": "^3.3.0",
    "typescript-eslint": "^8.15.0",
    "prisma": "^5.22.0",
    "@prisma/client": "^5.22.0"
  }
}
