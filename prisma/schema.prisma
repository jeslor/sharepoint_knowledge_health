generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums (ADR-0007 domain model, ADR-0002 scoring bands/criteria)
// ---------------------------------------------------------------------------

enum OrganizationStatus {
  Active
  Suspended
}

enum UserRole {
  Admin
  // Phase 8A / ADR-0016 §4.6: scoped to governance only (issues, document
  // ownership assignment, review workflows) — never tenant connections,
  // site approval, or scan scheduling, which remain Admin-only. Admin is a
  // strict superset of this role's capabilities.
  GovernanceManager
  Member
}

enum UserStatus {
  Active
  Deactivated
  // ADR-0012: default status for an automatically-provisioned user signing
  // in for the first time under an already-connected MicrosoftTenant.
  // Governs authorization only — identity is still fully resolved via
  // (tid, oid) per ADR-0011; access is simply withheld until an existing
  // Admin explicitly approves them.
  PendingApproval
}

// ADR-0014: a site is scan-eligible only in the Approved state. New sites
// (whether from initial discovery or a later rescan) always start
// Discovered — never auto-approved, under any circumstance.
enum SharePointSiteStatus {
  Discovered
  Approved
  Removed
}

enum MicrosoftTenantStatus {
  PendingConsent
  Consented
  Revoked
}

// ADR-0014 amendment (2026-07-20): the current discovery job's state only —
// not history, not an audit trail (see ADR-0019 for that). Overwritten by
// each new discovery run.
enum DiscoveryStatus {
  NotStarted
  Queued
  Running
  Completed
  Failed
}

enum DocumentStatus {
  Active
  Removed
}

enum DocumentOwnerType {
  Author
  AssignedOwner
  Unknown
}

enum DocumentOwnerSource {
  GraphMetadata
  ManualAssignment
}

enum ScanJobStatus {
  Queued
  Running
  Completed
  Failed
  Cancelled
}

// ADR-0015 §1 / Phase 7B: distinguishes a human-clicked scan from one the
// scheduler produced — triggeredByUserId is null exactly when this is
// Scheduled (no human to attribute it to).
enum ScanJobTriggerSource {
  Manual
  Scheduled
}

// Deliberately narrow (no free-form cron) — avoids a new cron-parsing
// dependency for an MVP that only needs two options (ADR-0015 §1).
enum ScanScheduleFrequency {
  Daily
  Weekly
}

enum HealthBand {
  Healthy
  NeedsAttention
  RequiresReview
}

enum HealthIssueCriterion {
  Freshness
  Ownership
  ReviewStatus
  Metadata
  Duplication
  Age
}

enum HealthIssueSeverity {
  NeedsAttention
  RequiresReview
}

// ADR-0016 §4.5: deliberately 3 states, not 5 — ASSIGNED is modeled as the
// orthogonal GovernanceIssue.assignedUserId field, not a status; VERIFIED
// is replaced by a derived, read-time "still detected in latest scan" flag
// (never stored) computed against the document's current HealthIssues.
enum GovernanceIssueStatus {
  Open
  InProgress
  Resolved
}

// ADR-0022 §6/§13.1: terminal once every RemediationItem reaches a
// terminal state of its own (Succeeded/Failed/Skipped) — not stored per
// item, computed by whoever finalizes the job.
enum RemediationJobStatus {
  Running
  Completed
}

// ADR-0022 §13.3: a write that succeeds but can't be verified stays
// Pending (retryable) — never a distinct status, never Failed, never
// Succeeded without confirmation. See that section for the full
// rationale; this enum intentionally has no "verification failed" or
// "retryable" value beyond Pending itself.
enum RemediationItemStatus {
  Pending
  Succeeded
  Failed
  Skipped
}

// ADR-0016 §4.3: same reserved-until-later shape as DocumentOwnerSource.
// GraphMetadata is unused until a future Graph List Items API integration
// (ADR-0016 §9) — Phase 8A only ever writes Manual.
enum DocumentReviewDateSource {
  Manual
  GraphMetadata
}

// Active: the mapped column currently resolves in Graph and governs
// nextReviewDueAt on sync. Stale: the column no longer resolves (deleted,
// or the list itself is inaccessible) — the worker stops applying
// GraphMetadata values from this mapping until it recovers, but never
// clears a document's existing value when this happens.
enum SharePointReviewDateMappingStatus {
  Active
  Stale
}

// Phase 8C: one row per recorded governance action. PascalCase to match
// this schema's existing enum convention (every other enum here already
// does this — not a departure, just consistency with e.g.
// GovernanceIssueStatus, ScanJobTriggerSource). StatusChanged covers the
// Open<->InProgress edge only; the InProgress->Resolved and Resolved->Open
// edges get their own, more specific types (IssueResolved/IssueReopened)
// since those are the two transitions a reader most wants to scan for.
enum GovernanceActivityType {
  IssueCreated
  IssueAssigned
  AssigneeChanged
  StatusChanged
  ResolutionNoteUpdated
  OwnerAssigned
  OwnerRemoved
  IssueReopened
  IssueResolved
}

/// ADR-0021 §3.2: the V1 notification trigger set only — deliberately not
/// every GovernanceActivityType (e.g. no StatusChanged/ResolutionNoteUpdated,
/// which would be pure noise). ResolutionSuggested is the one type with no
/// synchronous GovernanceActivity counterpart — it's written by the
/// asynchronous reconciliation job (ADR-0021 §3.3), not by
/// GovernanceActivityService.
enum NotificationType {
  IssueAssigned
  OwnerAssigned
  IssueReopened
  ResolutionSuggested
  // Worker-driven (apps/worker's document-collector.processor.ts), when a
  // document transitions Active -> Removed while it has an Open/InProgress
  // GovernanceIssue — deliberately NOT a GovernanceActivity type: that
  // model's actorUserId is required (no human performed this), and its own
  // design principle is human/API-driven governance actions, not
  // scan-observed facts. See ADR-0021's removed-document amendment.
  DocumentRemoved
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

/// The customer account (tenant of our SaaS). Root of the tenancy tree.
model Organization {
  id        String             @id @default(cuid())
  name      String
  status    OrganizationStatus @default(Active)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  users                        User[]
  microsoftTenants             MicrosoftTenant[]
  sharePointSites              SharePointSite[]
  documents                    Document[]
  documentOwners               DocumentOwner[]
  scanJobs                     ScanJob[]
  scanSchedule                 ScanSchedule?
  healthScores                 HealthScore[]
  healthIssues                 HealthIssue[]
  healthSnapshots              HealthSnapshot[]
  governanceIssues             GovernanceIssue[]
  governanceActivity           GovernanceActivity[]
  auditLogs                    AuditLog[]
  notifications                Notification[]
  sharePointReviewDateMappings SharePointReviewDateMapping[]
  remediationJobs              RemediationJob[]
  remediationItems             RemediationItem[]

  @@index([status])
}

/// A person who signs into the dashboard. Belongs to exactly one Organization.
model User {
  id                String     @id @default(cuid())
  organizationId    String
  microsoftTenantId String
  entraObjectId     String
  email             String
  displayName       String
  role              UserRole   @default(Member)
  status            UserStatus @default(Active)
  createdAt         DateTime   @default(now())
  lastLoginAt       DateTime?

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  microsoftTenant MicrosoftTenant @relation("UserHomeMicrosoftTenant", fields: [microsoftTenantId], references: [id], onDelete: Restrict)

  consentedMicrosoftTenants   MicrosoftTenant[]             @relation("MicrosoftTenantConsentedBy")
  triggeredScanJobs           ScanJob[]                     @relation("ScanJobTriggeredBy")
  approvedSharePointSites     SharePointSite[]              @relation("SharePointSiteApprovedBy")
  assignedGovernanceIssues    GovernanceIssue[]             @relation("GovernanceIssueAssignedTo")
  assignedDocumentOwners      DocumentOwner[]               @relation("DocumentOwnerAssignedBy")
  governanceActivityAsActor   GovernanceActivity[]          @relation("GovernanceActivityActor")
  auditLogEntries             AuditLog[]
  notifications               Notification[]
  confirmedReviewDateMappings SharePointReviewDateMapping[] @relation("SharePointReviewDateMappingConfirmedBy")
  initiatedRemediationJobs    RemediationJob[]              @relation("RemediationJobInitiatedBy")

  // The Entra oid claim (entraObjectId) is only unique WITHIN the Azure AD
  // tenant that issued it (ADR-0010) — Microsoft's own multi-tenant app
  // guidance requires the oid+tid combination as the unique identifying
  // key, never oid alone. microsoftTenantId is our FK standing in for tid.
  @@unique([microsoftTenantId, entraObjectId])
  @@index([organizationId, status])
}

/// One customer's connected Microsoft 365 / Azure AD tenant.
model MicrosoftTenant {
  id                     String                @id @default(cuid())
  organizationId         String
  entraTenantId          String
  tenantName             String
  status                 MicrosoftTenantStatus @default(PendingConsent)
  consentGrantedAt       DateTime?
  consentGrantedByUserId String?
  // ADR-0023 §3.3: two deliberately separate, honestly-scoped fields — not
  // one shared "granted permissions" version. verifiedReadPermissionVersion
  // is real evidence, advanced only after a passing GraphConsentVerifierService
  // check. consentAssertedPermissionVersion/consentAssertedAt only record
  // that an admin completed a real admin-consent redirect for the current
  // permission requirement — never proof of the effective (in particular,
  // write) grant. Nullable/additive; existing rows stay NULL (no backfill,
  // no manufactured historical evidence).
  verifiedReadPermissionVersion    Int?
  consentAssertedPermissionVersion Int?
  consentAssertedAt               DateTime?
  // ADR-0014 amendment (2026-07-20): current discovery job state only — see
  // the enum's own doc comment. Not history; ADR-0019's AuditLog owns that.
  discoveryStatus        DiscoveryStatus       @default(NotStarted)
  discoveryStartedAt     DateTime?
  discoveryCompletedAt   DateTime?
  discoveryError         String?
  createdAt              DateTime              @default(now())

  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  consentGrantedByUser User?        @relation("MicrosoftTenantConsentedBy", fields: [consentGrantedByUserId], references: [id], onDelete: SetNull)

  sharePointSites SharePointSite[]
  scanJobs        ScanJob[]
  homeUsers       User[]           @relation("UserHomeMicrosoftTenant")

  // entraTenantId is NOT globally unique (ADR-0007): isolation is by
  // organizationId, not by assuming one Microsoft tenant maps to one
  // Organization forever. Unique per-organization only.
  @@unique([organizationId, entraTenantId])
  @@index([organizationId, status])
  // Standalone index (ADR-0010): enables resolving a JWT's tid claim to
  // candidate MicrosoftTenant row(s) during login, before organizationId
  // is known — the compound unique above isn't usable for that lookup
  // since entraTenantId isn't its leading column.
  @@index([entraTenantId])
}

/// A SharePoint site discovered under a connected tenant. status governs
/// scan eligibility (ADR-0014) — a site is never scanned until an Admin
/// explicitly approves it, and that never happens automatically.
model SharePointSite {
  id                String               @id @default(cuid())
  organizationId    String
  microsoftTenantId String
  graphSiteId       String
  siteUrl           String
  displayName       String
  status            SharePointSiteStatus @default(Discovered)
  approvedAt        DateTime?
  approvedByUserId  String?
  lastScannedAt     DateTime?
  createdAt         DateTime             @default(now())

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  microsoftTenant MicrosoftTenant @relation(fields: [microsoftTenantId], references: [id], onDelete: Cascade)
  approvedByUser  User?           @relation("SharePointSiteApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  documents          Document[]
  reviewDateMappings SharePointReviewDateMapping[]

  @@unique([microsoftTenantId, graphSiteId])
  @@index([organizationId])
  @@index([organizationId, status])
}

/// A single SharePoint document tracked for health scoring.
model Document {
  id                   String         @id @default(cuid())
  organizationId       String
  siteId               String
  graphItemId          String
  name                 String
  path                 String
  fileType             String
  // Graph driveItem.webUrl — the user-facing "open in browser" link for
  // this file. Nullable: only populated going forward by the worker's
  // normal ingestion upsert (no backfill), same rollout shape as
  // nextReviewDueAt below. No new Graph call/permission — already part of
  // the default driveItem representation apps/worker already fetches.
  webUrl               String?
  sizeBytes            BigInt
  sourceCreatedAt      DateTime
  sourceModifiedAt     DateTime
  status               DocumentStatus @default(Active)
  currentHealthScoreId String?        @unique
  ingestedAt           DateTime       @default(now())

  // ADR-0016 §4.3 / Proposed ADR-0002 amendment: platform-maintained review
  // due date. Schema only in Phase 8A — NOT yet wired into the
  // ReviewStatus scoring input (hasReviewDate is still hardcoded false in
  // the worker until the separate ADR-0002 amendment is accepted).
  nextReviewDueAt  DateTime?
  reviewDateSource DocumentReviewDateSource @default(Manual)

  // SharePoint metadata integration, Phase 1a: the Graph list id backing
  // this document's drive (drive.list, resolved via the same listDrives
  // request via $expand — no extra Graph call). Nullable, forward-only
  // population — same rollout shape as webUrl/nextReviewDueAt above.
  // Column definitions and list items are scoped per-list in Graph, so
  // this is the identifier SharePointReviewDateMapping below is keyed on.
  graphListId String?

  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site               SharePointSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  currentHealthScore HealthScore?   @relation("CurrentHealthScore", fields: [currentHealthScoreId], references: [id], onDelete: SetNull)

  owners             DocumentOwner[]
  healthScores       HealthScore[]        @relation("DocumentHealthScores")
  governanceIssues   GovernanceIssue[]
  governanceActivity GovernanceActivity[]
  notifications      Notification[]
  remediationItems   RemediationItem[]

  @@unique([siteId, graphItemId])
  @@index([organizationId, status])
  @@index([siteId, status])
  @@index([organizationId, nextReviewDueAt])
}

/// SharePoint metadata integration, Phase 1b: one confirmed, active
/// review-date column mapping per SharePoint document library. Deliberately
/// minimal — no history/audit log, no per-org/site suggestion templates
/// (those are explicitly out of scope for Phase 1). columnDefinitionId is
/// the stable Graph identifier a mapping is keyed on (never name/
/// displayName, which can change on a rename) — the worker re-resolves the
/// column's current internal name from this id on every sync, which is
/// what makes a rename transparent (no schema/data change needed) while a
/// deletion is detected (the id no longer resolves) and flips status to
/// Stale rather than silently clearing any document's review date.
/// Library-scoped (siteId + graphListId), not org/site-wide: column
/// definitions themselves are scoped per-list in Graph, so a coarser scope
/// would assume a consistency Graph doesn't guarantee.
model SharePointReviewDateMapping {
  id             String @id @default(cuid())
  organizationId String
  siteId         String
  graphListId    String

  columnDefinitionId              String
  // Snapshot at confirmation time — display-only (e.g. future admin UX),
  // never used to re-resolve the column; the worker always re-reads the
  // live displayName from Graph for that purpose.
  columnDisplayNameAtConfirmation String

  status          SharePointReviewDateMappingStatus @default(Active)
  staleDetectedAt DateTime?

  confirmedByUserId String
  confirmedAt       DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site            SharePointSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  // Restrict, matching GovernanceActivity.actorUserId's precedent — who
  // confirmed a mapping is provenance, never silently lost to a user
  // deletion.
  confirmedByUser User           @relation("SharePointReviewDateMappingConfirmedBy", fields: [confirmedByUserId], references: [id], onDelete: Restrict)

  // One active mapping per library — re-confirming replaces this row's
  // columnDefinitionId/status rather than creating a second one.
  @@unique([siteId, graphListId])
  @@index([organizationId])
}

/// Ownership signal(s) for a document (author / assigned owner / unknown).
/// ADR-0016 §4.2: source partitions write ownership between two callers
/// that must never overlap — apps/worker's syncOwner() only ever
/// touches source: GraphMetadata rows; source: ManualAssignment rows are
/// only ever created/deleted through the governance API (Phase 8B),
/// guaranteeing a manual assignment survives every future rescan.
model DocumentOwner {
  id             String              @id @default(cuid())
  documentId     String
  organizationId String
  ownerType      DocumentOwnerType
  displayName    String?
  email          String?
  source         DocumentOwnerSource

  // Only set when source: ManualAssignment — same audit-trail shape as
  // SharePointSite.approvedByUserId/approvedAt (ADR-0014).
  assignedByUserId String?
  assignedAt       DateTime?

  document       Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedByUser User?        @relation("DocumentOwnerAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@index([documentId])
  @@index([organizationId])
}

/// A single execution of the scan pipeline (ADR-0004).
model ScanJob {
  id                String               @id @default(cuid())
  organizationId    String
  microsoftTenantId String
  // Nullable since Phase 7B — a Scheduled scan has no human trigger.
  // Distinguished by triggerSource, never inferred from nullness alone.
  triggeredByUserId String?
  triggerSource     ScanJobTriggerSource @default(Manual)
  status            ScanJobStatus        @default(Queued)
  startedAt         DateTime?
  completedAt       DateTime?
  documentsScanned  Int                  @default(0)
  documentsFailed   Int                  @default(0)
  errorSummary      String?
  createdAt         DateTime             @default(now())

  // ADR-0015 §5: live progress while Running, written by the worker's
  // existing per-site loop (not per-document — write-volume tradeoff
  // already decided in the ADR). totalSites/currentSiteName are null
  // before the worker's first update; currentSiteName is cleared back to
  // null once the loop finishes, regardless of final status.
  totalSites      Int?
  sitesCompleted  Int     @default(0)
  currentSiteName String?

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  microsoftTenant MicrosoftTenant @relation(fields: [microsoftTenantId], references: [id], onDelete: Cascade)
  triggeredByUser User?           @relation("ScanJobTriggeredBy", fields: [triggeredByUserId], references: [id], onDelete: Restrict)

  healthScores   HealthScore[]
  healthSnapshot HealthSnapshot?

  @@index([organizationId, status])
  @@index([microsoftTenantId, status])
  @@index([organizationId, createdAt])
}

/// An organization's recurring scan configuration (ADR-0015 §1, Phase 7B).
/// One per organization (organizationId is unique) — which MicrosoftTenant
/// actually gets scanned is resolved the same way manual org-level scan
/// triggers already resolve it (the org's single Consented tenant), not
/// stored here. Postgres is the sole source of truth for scheduling state;
/// the worker's repeatable heartbeat job is only a trigger, never a
/// registry (ADR-0015 §1, Option B).
model ScanSchedule {
  id             String                @id @default(cuid())
  organizationId String                @unique
  frequency      ScanScheduleFrequency
  enabled        Boolean               @default(true)
  nextRunAt      DateTime
  lastRunAt      DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Exactly the scheduler tick's WHERE clause (findDueScanSchedules).
  @@index([enabled, nextRunAt])
}

/// Result of scoring one document during one scan. Immutable once written.
model HealthScore {
  id                String     @id @default(cuid())
  organizationId    String
  documentId        String
  scanJobId         String
  compositeScore    Int
  freshnessScore    Int
  ownershipScore    Int
  reviewStatusScore Int
  metadataScore     Int
  duplicationScore  Int
  ageScore          Int
  healthBand        HealthBand
  calculatedAt      DateTime   @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document     Document     @relation("DocumentHealthScores", fields: [documentId], references: [id], onDelete: Cascade)
  scanJob      ScanJob      @relation(fields: [scanJobId], references: [id], onDelete: Cascade)

  // Inverse of Document.currentHealthScoreId — a HealthScore is pointed to
  // by at most one Document as its "current" score.
  currentForDocument Document? @relation("CurrentHealthScore")

  healthIssues HealthIssue[]

  @@index([organizationId, documentId, calculatedAt])
  @@index([scanJobId])
}

/// Org-level health aggregate captured once per successfully Completed
/// scan (ADR-0015 §3) — persists what health-summary otherwise only ever
/// computes live, so it can be read back historically. Never written for
/// a Failed scan. One per ScanJob, enforced by the unique scanJobId.
model HealthSnapshot {
  id                    String   @id @default(cuid())
  organizationId        String
  scanJobId             String   @unique
  totalDocumentsScanned Int
  averageHealthScore    Int?
  criticalIssuesCount   Int
  warningIssuesCount    Int
  capturedAt            DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scanJob      ScanJob      @relation(fields: [scanJobId], references: [id], onDelete: Cascade)

  @@index([organizationId, capturedAt])
}

/// A flagged problem on one scoring criterion for one HealthScore. Immutable.
model HealthIssue {
  id             String               @id @default(cuid())
  organizationId String
  healthScoreId  String
  criterion      HealthIssueCriterion
  severity       HealthIssueSeverity
  message        String
  createdAt      DateTime             @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  healthScore  HealthScore  @relation(fields: [healthScoreId], references: [id], onDelete: Cascade)

  @@index([healthScoreId])
  @@index([organizationId, criterion])
}

/// User workflow state for a governed problem (ADR-0016 §4.1) — kept
/// entirely separate from HealthIssue, which stays calculated, immutable,
/// scan-owned evidence. Written only by apps/api, never by apps/worker.
///
/// Keyed by (documentId, issueType), not a specific HealthIssue row: a
/// HealthIssue has no identity across scans (a new row every scan that
/// still detects the problem), so a GovernanceIssue is a durable workflow
/// thread for "this problem type on this document," reused across
/// resolve/reopen cycles rather than a new row per cycle (a deliberate v1
/// simplification — no per-transition audit log yet). Whether the
/// underlying HealthIssue is still present in the latest scan is a
/// read-time derived flag (Document.currentHealthScore.healthIssues),
/// never stored here.
model GovernanceIssue {
  id              String                @id @default(cuid())
  organizationId  String
  documentId      String
  issueType       HealthIssueCriterion
  severity        HealthIssueSeverity
  // Snapshot of the matching HealthIssue.message at creation time — the
  // same "captured once, never auto-updated" treatment already given to
  // `severity` above. Deliberately NOT re-derived from the current
  // HealthIssue on read: it's historical evidence of what was detected,
  // and must stay visible even after remediation makes the underlying
  // HealthIssue disappear. Nullable: issues created before this column
  // existed have no message and are not backfilled.
  message         String?
  status          GovernanceIssueStatus @default(Open)
  assignedUserId  String?
  resolutionNotes String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  resolvedAt      DateTime?

  organization  Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document      Document             @relation(fields: [documentId], references: [id], onDelete: Cascade)
  assignedUser  User?                @relation("GovernanceIssueAssignedTo", fields: [assignedUserId], references: [id], onDelete: SetNull)
  activity      GovernanceActivity[]
  notifications Notification[]

  @@unique([documentId, issueType])
  @@index([organizationId, status])
  @@index([assignedUserId])
}

/// Immutable, append-only record of every governance action (Phase 8C).
/// No update or delete path exists anywhere in this codebase for this
/// model — GovernanceActivityRepository deliberately exposes only
/// findMany/findFirstById/count/create, the same "enforced by the public
/// API shape itself, not just by convention" discipline ADR-0013 §8
/// already established for packages/graph-client's read-only surface.
///
/// governanceIssueId is nullable: issue-lifecycle activity types
/// (IssueCreated, IssueAssigned, AssigneeChanged, StatusChanged,
/// ResolutionNoteUpdated, IssueReopened, IssueResolved) always set it;
/// document-ownership activity types (OwnerAssigned, OwnerRemoved) don't
/// — a manual ownership assignment isn't tied to any specific
/// GovernanceIssue. documentId is required on every row instead, since
/// every governance action — issue or ownership — happens in the context
/// of exactly one document.
model GovernanceActivity {
  id                String                 @id @default(cuid())
  organizationId    String
  governanceIssueId String?
  documentId        String
  actorUserId       String
  activityType      GovernanceActivityType
  // Deliberately plain display-ready strings, not raw ids — e.g. the
  // assignee's displayName, not their User.id. Resolved once, at write
  // time, when the acting service already has that context in hand; this
  // is what keeps every read path (list/paginate/filter) a single query
  // with no secondary batch lookup to render human-readable text.
  previousValue     String?
  newValue          String?
  metadata          Json?
  createdAt         DateTime               @default(now())

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  governanceIssue GovernanceIssue? @relation(fields: [governanceIssueId], references: [id], onDelete: Cascade)
  document        Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  // Restrict, matching ScanJob.triggeredByUserId's precedent (ADR-0007) —
  // an audit trail must never silently lose who performed an action, so a
  // User row can never be hard-deleted while activity still references it.
  actorUser       User             @relation("GovernanceActivityActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([governanceIssueId, createdAt])
  @@index([organizationId, activityType])
}

/// A per-user, in-app notification inbox (ADR-0021). Deliberately NOT a
/// duplicate of GovernanceActivity: this is a personal inbox (filtered to
/// one userId), GovernanceActivity is a shared, organization-wide audit
/// feed — the same "two entities answering two different questions" split
/// ADR-0016 §4.1 already established for HealthIssue vs. GovernanceIssue.
model Notification {
  id                String           @id @default(cuid())
  organizationId    String
  userId            String
  type              NotificationType
  // Pre-resolved, human-readable at write time — matches
  // GovernanceActivity's own previousValue/newValue precedent ("resolve
  // once, read cheaply"), not a raw id needing a secondary lookup to render.
  message           String
  governanceIssueId String?
  documentId        String?
  read              Boolean          @default(false)
  createdAt         DateTime         @default(now())
  // Phase D.2 correctness fix: an optional, caller-computed idempotency key
  // — null for every notification type except reconciliation's
  // ResolutionSuggested (the only one created by a path that can run
  // concurrently for the same recipient: event-driven scan completion,
  // the hourly sweep, and BullMQ redelivery can all trigger reconciliation
  // for the same organization). NotificationReconciliationService builds
  // this as `${governanceIssueId}:${issue.updatedAt.getTime()}` — unique
  // per (issue, generation), so a reopen-and-refix cycle naturally gets a
  // NEW key (a genuine new suggestion is never blocked), while concurrent
  // reconciliation runs for the SAME generation collide on the SAME key.
  // The @unique constraint below is what makes upsertByDedupeKey's
  // create-or-no-op atomic and race-free — Postgres enforces it, not
  // application logic. NULL values never collide with each other under a
  // standard unique constraint, so every other notification type (which
  // never sets this field) is completely unaffected.
  dedupeKey         String?          @unique

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Cascade, not the SetNull every other <action>ByUserId field in this
  // schema uses — this is a deliberate deviation. Every other User FK in
  // this schema exists to preserve *who did something* even after that
  // user is gone (an audit fact). userId here is a recipient, not an
  // actor — a notification has no meaning once the person it was for no
  // longer exists, so nothing is lost by letting it cascade away with them.
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  governanceIssue GovernanceIssue? @relation(fields: [governanceIssueId], references: [id], onDelete: SetNull)
  document        Document?        @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([organizationId, userId, read])
  @@index([organizationId, userId, createdAt])
}

/// Organization-wide administrative action history (ADR-0019) — a sibling
/// of GovernanceActivity, not a replacement. GovernanceActivity tracks the
/// workflow of one governed problem on one document; AuditLog tracks
/// organization-level administrative actions (site approval, scan
/// triggering, user approval, tenant connection) that aren't tied to any
/// specific document's governance thread — the two never overlap in
/// subject matter. Append-only, enforced the same way GovernanceActivity
/// already is: AuditLogRepository exposes no update/delete method, even by
/// mistake.
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  // Nullable — reserved for a future system-driven event (e.g. an eventual
  // tenant-revocation health check, ADR-0012's amendment, not yet built).
  // Every action this phase actually writes has a real human actor.
  actorUserId    String?
  action         String // e.g. "sharepoint_site.approved"
  targetType     String // e.g. "SharePointSite", "User", "ScanSchedule"
  targetId       String
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // SetNull (not Restrict, unlike GovernanceActivity.actorUser): a deleted
  // User row must never cascade away audit history, and must never be
  // blocked by audit history either (ADR-0019 §1).
  actorUser    User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}

/// ADR-0022 (as amended by its 2026-08-21 §13 addendum): one row per bulk
/// remediation operation. issueType reuses HealthIssueCriterion as its key
/// (no parallel taxonomy) — Phase 3A-2 only ever writes 'ReviewStatus'.
/// initiatedByRole is captured at creation time so a worker processing
/// this job later never re-derives authorization from request state that
/// may no longer exist (ADR-0022 §8).
model RemediationJob {
  id                String               @id @default(cuid())
  organizationId    String
  issueType         HealthIssueCriterion
  payload           Json
  status            RemediationJobStatus @default(Running)
  initiatedByUserId String
  initiatedByRole   UserRole
  totalCount        Int
  succeededCount    Int                  @default(0)
  failedCount       Int                  @default(0)
  createdAt         DateTime             @default(now())
  completedAt       DateTime?

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Restrict, matching ScanJob.triggeredByUserId/GovernanceActivity.actorUserId's
  // precedent — who initiated a bulk write must never be silently lost to
  // a user deletion.
  initiatedByUser User              @relation("RemediationJobInitiatedBy", fields: [initiatedByUserId], references: [id], onDelete: Restrict)
  items           RemediationItem[]

  @@index([organizationId, status])
}

/// ADR-0022 §13.1: organizationId is a direct column here too, not scoped
/// only through the parent RemediationJob — matching this schema's
/// otherwise-100%-consistent convention (HealthIssue, HealthScore,
/// GovernanceIssue, SharePointReviewDateMapping, ScanJob all carry their
/// own organizationId; there is no existing precedent anywhere in this
/// schema for parent-only tenant scoping).
///
/// ADR-0022 §13.3: a write that PATCHes successfully but whose targeted
/// re-fetch cannot confirm the expected value stays Pending (retryable),
/// never Failed and never Succeeded without confirmation — see that
/// section. errorType mirrors @sph/graph-client's error class names
/// directly (e.g. "GraphPermissionError") — no new taxonomy.
model RemediationItem {
  id               String                @id @default(cuid())
  organizationId   String
  remediationJobId String
  documentId       String
  status           RemediationItemStatus @default(Pending)
  errorType        String?
  errorMessage     String?
  attemptCount     Int                   @default(0)
  updatedAt        DateTime              @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  remediationJob RemediationJob @relation(fields: [remediationJobId], references: [id], onDelete: Cascade)
  document       Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([remediationJobId, documentId])
  @@index([organizationId, status])
  @@index([remediationJobId, status])
}
