# apps/web — Phase 6 frontend MSAL browser auth (ADR-0011 client-side
# completion). Next.js only loads .env files from apps/web itself, not the
# monorepo root — copy this to .env.local for real local dev.

# Same multi-tenant Entra app registration's client ID the API validates
# JWTs against (ENTRA_CLIENT_ID in the root .env) — the frontend and API
# must agree on this value, since the ID token's aud claim has to match.
# Must be a real Entra App Registration's Application (client) ID — the
# placeholder all-zeros GUID below will fail at Microsoft's login page with
# AADSTS700038 ("not a valid application identifier"). Create one at
# https://portal.azure.com -> Microsoft Entra ID -> App registrations ->
# New registration, "Accounts in any organizational directory" (multi-tenant).
NEXT_PUBLIC_ENTRA_CLIENT_ID="00000000-0000-0000-0000-000000000000"
NEXT_PUBLIC_API_BASE_URL="http://localhost:3001"


NEXT_PUBLIC_ADMIN_CONSENT_REDIRECT_URI=http://localhost:3000/connect/admin-consent-callback

# Optional — defaults to window.location.origin at runtime if unset (e.g.
# http://localhost:3000 for local dev). Whatever this resolves to MUST be
# registered as a Redirect URI in the App Registration above, under the
# "Single-page application" platform (not "Web") — the SPA/PKCE auth code
# flow msal-browser uses requires the SPA platform type specifically.
# NEXT_PUBLIC_REDIRECT_URI="http://localhost:3000"
test
